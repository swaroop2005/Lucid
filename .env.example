PORT=4317
APP_NAME=Lucid
# Local deterministic defaults; no hosted credentials are bundled.
MEMORY_MODE=offline
AGENT_MODE=offline
ALLOW_EXTERNAL_CALLS=false
DATA_FILE=.data/lucid.sqlite
EVIDENCE_FILE=.data/evidence.sqlite
SETTINGS_FILE=.data/cloud-credentials.json
HINDSIGHT_CREDIT_LEDGER=work/hindsight-50-ledger.json
# Optional server-side input for npm run cloud:configure only.
# These variables alone do not configure the current UI workflow.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK=replace-with-authorized-bank
HINDSIGHT_API_KEY=replace-with-private-key
